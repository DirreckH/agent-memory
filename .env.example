# -------------------- 服务 --------------------
APP_NAME=Agent Memory API
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/agent_memory.db
DATA_RETENTION_DAYS=30
INGESTION_STALE_SECONDS=300

# 简化 /set、/get 接口和输入限制。
LOCAL_USER_ID=local-default
MAX_MEMORY_CHARS=200000
MAX_QUERY_CHARS=20000

# 公网部署必须设置强随机值；本地调试可留空。
MEMORY_API_KEY=

# -------------------- 向量模型 --------------------
# EMBEDDING_PROVIDER=fastembed：本地 ONNX，离线可用（默认）。
# EMBEDDING_PROVIDER=dashscope：阿里百炼 API。学术榜（开源方法榜）当前要求
# 统一使用 text-embedding-v4，提交学术榜时改用下方配置：
#   EMBEDDING_PROVIDER=dashscope
#   EMBEDDING_MODEL=text-embedding-v4
#   DASHSCOPE_API_KEY=你的百炼密钥
# 注意：更换向量模型后维度不同，必须换全新数据库，不能混用分数。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=data/model_cache
EMBEDDING_THREADS=2
WARMUP_EMBEDDING_ON_STARTUP=false
MIN_RELEVANCE_SCORE=0.20
SEMANTIC_WEIGHT=0.80
LEXICAL_WEIGHT=0.20
MAX_TOP_K=100
CANDIDATE_POOL_SIZE=400

# DashScope 向量（EMBEDDING_PROVIDER=dashscope 时生效）。
# text-embedding-v4：默认 1024 维（可选 64-2048），单次请求最多 10 条（自动分批）。
# EMBEDDING_DIMENSIONS 留空走服务端默认。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TIMEOUT_SECONDS=30
DASHSCOPE_MAX_RETRIES=2
EMBEDDING_DIMENSIONS=

# -------------------- 时间感知检索（V3）--------------------
# off=关闭；soft=时间项加权参与打分（默认）；strict=窗口内候选足够时截掉窗口外记录。
TEMPORAL_MODE=soft
TEMPORAL_WEIGHT=0.20
TEMPORAL_DECAY_HALF_LIFE_DAYS=30
TEMPORAL_EVENT_ANCHOR_MIN_SCORE=0.30

# 双通道查询：扩展文本与裸查询分别嵌入打分取较大值，防止扩展稀释弱证据。
# false 回退为 V3 的单通道混合查询。
QUERY_DUAL_CHANNEL=true

# 接口输入日志：记录 /set、/get 的请求正文到 JSONL，用于联调与复盘。
# 文件按天轮转，保留份数对齐 DATA_RETENTION_DAYS（评测数据到期自动删除）。
# 只记请求体，永不记请求头；单条正文超长截断。
INPUT_LOG_ENABLED=true
INPUT_LOG_PATH=data/logs/input.jsonl
INPUT_LOG_MAX_CHARS=20000

# -------------------- LLM --------------------
# 无密钥也可运行基础向量检索；填好密钥后改为 deepseek。
LLM_PROVIDER=none
LLM_FAILURE_MODE=fallback
LLM_ADD_ENRICHMENT=true
LLM_SEARCH_EXPANSION=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# DeepSeek：不要提交包含真实密钥的 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 官网当前 Full 检查项要求 gpt-4o-mini；仅在正式合规模式使用。
# 官方端点国内服务器不可直连，可改用 ChatAnywhere 中转（gpt-4o-mini 走 OpenAI 官方转发）：
#   OPENAI_BASE_URL=https://api.chatanywhere.tech/v1   # 国内首选
#   OPENAI_BASE_URL=https://api.chatanywhere.org/v1    # 国外
# 注意：免费线 gpt-4o-mini 限 200 次/天/IP，仅够自测；正式评测需付费 key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
