# -------------------- 服务 --------------------
APP_NAME=Agent Memory API
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/agent_memory.db
DATA_RETENTION_DAYS=30
INGESTION_STALE_SECONDS=300

# 简化 /set、/get 接口和输入限制。
LOCAL_USER_ID=local-default
MAX_MEMORY_CHARS=200000
MAX_QUERY_CHARS=20000

# 公网部署必须设置强随机值；本地调试可留空。
MEMORY_API_KEY=

# -------------------- 向量模型 --------------------
# EMBEDDING_PROVIDER=fastembed：本地 ONNX，离线可用（默认）。
# EMBEDDING_PROVIDER=dashscope：阿里百炼 API。学术榜（开源方法榜）当前要求
# 统一使用 text-embedding-v4，提交学术榜时改用下方配置：
#   EMBEDDING_PROVIDER=dashscope
#   EMBEDDING_MODEL=text-embedding-v4
#   DASHSCOPE_API_KEY=你的百炼密钥
# 注意：更换向量模型后维度不同，必须换全新数据库，不能混用分数。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=data/model_cache
EMBEDDING_THREADS=2
WARMUP_EMBEDDING_ON_STARTUP=false
MIN_RELEVANCE_SCORE=0.20
SEMANTIC_WEIGHT=0.80
LEXICAL_WEIGHT=0.20
MAX_TOP_K=100
CANDIDATE_POOL_SIZE=400

# DashScope 向量（EMBEDDING_PROVIDER=dashscope 时生效）。
# text-embedding-v4：默认 1024 维（可选 64-2048），单次请求最多 10 条（自动分批）。
# EMBEDDING_DIMENSIONS 留空走服务端默认。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TIMEOUT_SECONDS=30
DASHSCOPE_MAX_RETRIES=2
EMBEDDING_DIMENSIONS=

# -------------------- 时间感知检索（V3）--------------------
# off=关闭；soft=时间项加权（默认）；strict=窗内、未知、窗外分组排序后截断。
TEMPORAL_MODE=soft
# replay=按当前用户的源消息时间回放（默认）；realtime=按本次检索开始时刻。
# 回放缺少可信源消息时间时放弃相对窗口；入库时间不参与锚点计算。
TEMPORAL_REFERENCE_MODE=replay
# 独立于 LLM_SEARCH_EXPANSION：off=关闭；rules=仅规则；hybrid=规则优先，复杂表达用 LLM。
# LLM_PROVIDER=none 时仍可运行规则；无法完整表达的约束放弃，不猜测。
TEMPORAL_EXTRACTION_MODE=hybrid
TEMPORAL_WEIGHT=0.20
TEMPORAL_DECAY_HALF_LIFE_DAYS=30
TEMPORAL_EVENT_ANCHOR_MIN_SCORE=0.30

# 双通道查询：扩展文本与裸查询分别嵌入打分取较大值，防止扩展稀释弱证据。
# false 回退为 V3 的单通道混合查询。
QUERY_DUAL_CHANNEL=true

# 多跳：默认复用基础查询向量，原文名称/共享片段仅在本地桥接。
# 保留基础检索已返回的顺序与分数，只补入剩余名额；不额外调用 LLM。
MULTIHOP_ENABLED=true
# 默认复用 V3 查询扩展；true 更换同一次调用的提示词并提高输出上限，不增加独立规划调用。
MULTIHOP_STRUCTURED_PLANNER=false
MULTIHOP_EMBED_GOALS=false
# 同一写入批次的前后原文数量；0 关闭上下文补充，输入顺序不代表事件时间。
MULTIHOP_CONTEXT_RADIUS=2
MULTIHOP_MIN_TOP_K=6
MULTIHOP_MAX_ROUNDS=2
MULTIHOP_SEED_LIMIT=3
MULTIHOP_BRIDGE_LIMIT=4
MULTIHOP_SUPPLEMENT_LIMIT=12
# 本地扩展阶段的时间预算，不含查询规划和向量生成。
MULTIHOP_BUDGET_SECONDS=6

# -------------------- D1/F1 派生治理索引 --------------------
# off=原检索；shadow=增加索引并内部对照，返回原结果；active=显式启用治理检索。
# 缺省保持 off，验证环境使用 shadow；不会自动切换 active。
GOVERNANCE_MODE=off
# 仅 active 有效；true 时独立抽取不完整会使本次写入失败。
GOVERNANCE_STRICT_WRITE=false
GOVERNANCE_INPUT_TOKENS=3000
GOVERNANCE_OUTPUT_TOKENS=4096
GOVERNANCE_ADD_BUDGET_SECONDS=60
GOVERNANCE_SUMMARY_BUDGET_MS=50
GOVERNANCE_QUERY_BUDGET_MS=50
GOVERNANCE_CONTENT_TOKENS=8192
# 工程 token 上限使用固定 cl100k_base 编码，不等同于提供方计费计数。

# 接口输入日志：记录 /set、/get 的请求正文到 JSONL，用于联调与复盘。
# 文件按天轮转，保留份数对齐 DATA_RETENTION_DAYS（评测数据到期自动删除）。
# 只记请求体，永不记请求头；单条正文超长截断。
INPUT_LOG_ENABLED=true
INPUT_LOG_PATH=data/logs/input.jsonl
INPUT_LOG_MAX_CHARS=20000

# -------------------- LLM --------------------
# 无密钥也可运行基础向量检索；填好密钥后改为 deepseek。
LLM_PROVIDER=none
LLM_FAILURE_MODE=fallback
LLM_ADD_ENRICHMENT=true
LLM_SEARCH_EXPANSION=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# DeepSeek：不要提交包含真实密钥的 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI 模式预设 gpt-4o-mini；正式评测模型要求以官网最新清单为准。
# 其他 OpenAI 兼容服务可配置实际 BASE_URL；模型身份、配额和数据规则需另行核验。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
